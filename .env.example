# ─────────────────────────────────────────────────────────────────────────────
# Lattice — environment template
#
# EVERY value here is optional. With an empty .env the app runs in DEMO MODE:
# fully functional, $0, no network calls, no keys. Fill values in only to
# enable LIVE MODE. Never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# Public base URL (used for canonical links). Safe to expose.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Persistence (optional) ───────────────────────────────────────────────────
# With no values set, Lattice uses a local JSON repository (.lattice-data/),
# which is perfect for a single instance but NOT for serverless/multi-instance.
# For free-tier durable storage, create a Supabase project (free) and fill these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Authentication (optional) ────────────────────────────────────────────────
# Supabase Auth is used when the Supabase values above are present.
# Otherwise Lattice falls back to its built-in, cookie-based demo session
# (clearly labelled in the UI as non-production).
# Comma-separated list of emails granted admin access.
ADMIN_EMAILS=

# ── Free, keyless source providers (no cost) ─────────────────────────────────
# These require no API key. Set to "false" to disable any of them.
LATTICE_ENABLE_OPENALEX=true      # academic papers (OpenAlex)
LATTICE_ENABLE_CROSSREF=true      # academic metadata (Crossref)
LATTICE_ENABLE_ARXIV=true         # preprints (arXiv)
LATTICE_ENABLE_WIKIPEDIA=true     # reference / concept relationships
LATTICE_ENABLE_WORLDBANK=true     # official statistics
LATTICE_ENABLE_GDELT=true         # global news index

# ── Optional keyed providers ─────────────────────────────────────────────────
# The Guardian Open Platform has a free developer tier (rate-limited).
# https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# ── Optional AI enhancement (OFF by default) ─────────────────────────────────
# Lattice NEVER requires an LLM. The deterministic engine covers exploration,
# ranking, explanations, knowledge maps and next-step suggestions.
# Set AI_ENABLED=true ONLY if you explicitly want the optional synthesis layer.
AI_ENABLED=false
# "openai" | "anthropic" | "openrouter" | "ollama" | "custom"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ── Limits & guardrails ──────────────────────────────────────────────────────
LATTICE_MAX_UPLOAD_MB=25
LATTICE_RATE_LIMIT_PER_MIN=60
# Deep AI operations per account per month (only relevant when AI_ENABLED=true).
LATTICE_FREE_AI_QUOTA=5
